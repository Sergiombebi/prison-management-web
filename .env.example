# Copier ce fichier en .env.local (jamais versionné) puis adapter les valeurs.
# Redémarrer `npm run dev` après chaque modification.

# Adresse de l'API Laravel. Utiliser 127.0.0.1 plutôt que localhost :
# sous Windows, Node peut résoudre localhost en IPv6 alors que `php artisan serve` écoute en IPv4.
SGP_API_URL=http://127.0.0.1:8000/api/v1

# Mode hybride : domaines servis par l'API réelle, séparés par des virgules.
# Domaines : auth, tableauDeBord, detenus, mandats, discipline, sante, sorties, administration
# Vide ou absent = tout en données de démonstration.
SGP_API_LIVE=auth,detenus,discipline,sorties,sante,tableauDeBord

# Tout basculer sur l'API réelle d'un coup (prioritaire sur SGP_API_LIVE)
# SGP_API_MODE=live

# Latence simulée des données de démonstration, en millisecondes
SGP_MOCK_LATENCE_MS=250
