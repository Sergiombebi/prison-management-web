# Copier ce fichier en .env.local (jamais versionné) puis adapter les valeurs.

# Source des données : "mock" (fixtures locales, par défaut) ou "live" (API REST réelle)
SGP_API_MODE=mock

# Adresse de l'API — utilisée uniquement quand SGP_API_MODE=live
SGP_API_URL=http://localhost:5000/api

# Latence simulée du mode mock, en millisecondes (pour voir les états de chargement)
SGP_MOCK_LATENCE_MS=250
